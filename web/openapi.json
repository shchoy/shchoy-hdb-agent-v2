{
  "openapi": "3.1.0",
  "info": {
    "title": "plg-api",
    "version": "0.1.0"
  },
  "paths": {
    "/personas": {
      "get": {
        "summary": "List Personas",
        "description": "Staff personas offered by the mock sign-in screen.",
        "operationId": "list_personas_personas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserCtx"
                  },
                  "type": "array",
                  "title": "Response List Personas Personas Get"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Me",
        "operationId": "me_me_get",
        "parameters": [
          {
            "name": "x-plg-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Staff ID forwarded by the BFF",
              "title": "X-Plg-User"
            },
            "description": "Staff ID forwarded by the BFF"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCtx"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/threads": {
      "post": {
        "summary": "Create Thread",
        "operationId": "create_thread_threads_post",
        "parameters": [
          {
            "name": "x-plg-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Staff ID forwarded by the BFF",
              "title": "X-Plg-User"
            },
            "description": "Staff ID forwarded by the BFF"
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/threads/{thread_id}/runs": {
      "post": {
        "summary": "Create Run",
        "operationId": "create_run_threads__thread_id__runs_post",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          },
          {
            "name": "x-plg-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Staff ID forwarded by the BFF",
              "title": "X-Plg-User"
            },
            "description": "Staff ID forwarded by the BFF"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events; each frame's data is one RunEvent.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RunEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "RunRequest"
      },
      "ThreadCreated": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          }
        },
        "type": "object",
        "required": [
          "thread_id"
        ],
        "title": "ThreadCreated"
      },
      "UserCtx": {
        "properties": {
          "staff_id": {
            "type": "string",
            "title": "Staff Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "dept": {
            "type": "string",
            "title": "Dept"
          },
          "role": {
            "type": "string",
            "enum": [
              "director",
              "manager",
              "estate_manager",
              "officer",
              "analyst",
              "legal"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "staff_id",
          "name",
          "title",
          "dept",
          "role"
        ],
        "title": "UserCtx",
        "description": "The signed-in staff member. Approver roles and memory isolation key off this."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "CitationEvent": {
        "description": "A source the answer cites. `index` is the number of its `[n]` marker in the answer text.",
        "properties": {
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "span": {
            "$ref": "#/components/schemas/Span"
          },
          "type": {
            "const": "citation",
            "default": "citation",
            "title": "Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          }
        },
        "required": [
          "doc_id",
          "chunk_id",
          "title",
          "version",
          "location",
          "quote",
          "span",
          "seq",
          "index"
        ],
        "title": "CitationEvent",
        "type": "object"
      },
      "DoneEvent": {
        "properties": {
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "run_id"
        ],
        "title": "DoneEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "description": "The run failed. Any answer streamed so far is partial and must not be trusted.",
        "properties": {
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "run_id",
          "message"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "NodeEvent": {
        "description": "A graph node started or finished, for the trajectory view.",
        "properties": {
          "type": {
            "const": "node",
            "default": "node",
            "title": "Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "node": {
            "title": "Node",
            "type": "string"
          },
          "status": {
            "enum": [
              "started",
              "finished"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "node",
          "status"
        ],
        "title": "NodeEvent",
        "type": "object"
      },
      "Span": {
        "description": "Character offsets into the chunk's text: `text[start:end]` is the cited quote.",
        "properties": {
          "start": {
            "title": "Start",
            "type": "integer"
          },
          "end": {
            "title": "End",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Span",
        "type": "object"
      },
      "TokenEvent": {
        "properties": {
          "type": {
            "const": "token",
            "default": "token",
            "title": "Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "node": {
            "title": "Node",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "node",
          "text"
        ],
        "title": "TokenEvent",
        "type": "object"
      },
      "RunEvent": {
        "discriminator": {
          "mapping": {
            "citation": "#/components/schemas/CitationEvent",
            "done": "#/components/schemas/DoneEvent",
            "error": "#/components/schemas/ErrorEvent",
            "node": "#/components/schemas/NodeEvent",
            "token": "#/components/schemas/TokenEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/NodeEvent"
          },
          {
            "$ref": "#/components/schemas/TokenEvent"
          },
          {
            "$ref": "#/components/schemas/CitationEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          }
        ]
      }
    }
  }
}
