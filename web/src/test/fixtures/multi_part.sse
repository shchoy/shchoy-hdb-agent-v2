event: sql_trace
data: {"plan":"Count vacant units in Bayshore Vale","sql":"SELECT COUNT(*) AS vacant_units FROM units u JOIN blocks b ON b.block_id = u.block_id WHERE u.status = 'Vacant' AND u.vacant_since <= $as_of AND b.town_code = 'BV'","as_of":"2026-09-30","status":"ok","error":null,"result":{"columns":["vacant_units"],"row_count":1,"truncated":false,"rows":[[9]]},"concepts":[{"id":"plg:Vacant_v2","concept":"plg:Vacant","version":2,"label":"Vacant unit","effective_from":"2026-04-15","effective_to":null}],"warnings":[],"explanation":"9 units in Bayshore Vale were vacant on 2026-09-30 under Vacant v2 (effective 2026-04-15).","type":"sql_trace","seq":7}

